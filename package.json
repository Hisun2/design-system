{
  "name": "@ec21rnc/ui",
  "version": "0.1.0",
  "description": "EC21 R&C 사내 시스템 공용 UI: 디자인 토큰과 컴포넌트",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "src"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./chart": { "types": "./src/chart.d.ts", "default": "./src/chart.js" },
    "./feedback-form": { "types": "./src/feedback-form.d.ts", "default": "./src/feedback-form.js" },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "tokens": "node tokens/build.mjs",
    "gen": "node scripts/gen-index.mjs && node scripts/gen-assets.mjs",
    "dev": "vite playground --port 5199",
    "build:playground": "vite build playground",
    "docs": "vite docs --port 5198",
    "build:docs": "vite build docs",
    "check:docs": "node scripts/check-docs.mjs",
    "typecheck": "tsc -p playground"
  },
  "dependencies": {
    "@semcore/icon": "18.0.1",
    "@semcore/illustration": "18.0.0",
    "@semcore/ui": "18.1.0",
    "d3-scale": "^4.0.2"
  },
  "peerDependencies": {
    "react": "18 - 19",
    "react-dom": "18 - 19",
    "react-final-form": "^6.5.9"
  },
  "peerDependenciesMeta": {
    "react-final-form": { "optional": true }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "final-form": "^5.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-final-form": "^7.0.1",
    "typescript": "^5.6.0",
    "vite": "^8.0.0"
  }
}
